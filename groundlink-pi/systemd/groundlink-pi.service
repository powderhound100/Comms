[Unit]
Description=GROUNDLINK Pi SDR Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/groundlink
ExecStartPre=/bin/sleep 10
ExecStart=/opt/groundlink/venv/bin/python pi_agent.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Resource limits
MemoryMax=1G
CPUQuota=300%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=groundlink-pi

[Install]
WantedBy=multi-user.target
